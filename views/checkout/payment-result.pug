extends ../layout

mixin money(value)
  | #{Number(value || 0).toLocaleString('ko-KR')}원

block content
  .page-shell.narrow
    h1 결제 완료
    p.description 테스트 결제가 승인되었습니다.

    .summary-card
      span.label 주문번호
      strong= payment.orderId
      p
        | 승인번호:
        |
        b= payment.authCode
      p
        | 결제금액:
        |
        b
          +money(payment.amount)
      p
        | 카드:
        |
        b #{payment.cardBrand} **** #{payment.cardLast4}
      p
        | 승인일시:
        |
        b= payment.paidAt

    .actions
      a.button-link(href='/checkout/payment') 다른 결제 테스트
      a(href='/checkout') 내 서비스로 돌아가기
