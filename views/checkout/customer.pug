extends ../layout

block content
  .page-shell.narrow
    h1 고객정보 입력
    p.description 세금계산서/결제 확인에 필요한 기본 고객정보입니다.

    if errors && errors.length
      ul.alert
        each error in errors
          li= error

    form.card-form(method='post', action='/checkout/customer')
      label
        | 상호명
        input(type='text', name='companyName', value=values.companyName || '', required, autocomplete='organization')
      label
        | 대표자명
        input(type='text', name='ownerName', value=values.ownerName || '', required, autocomplete='name')
      label
        | 사업자등록번호
        input(type='text', name='businessNumber', value=values.businessNumber || '', placeholder='123-45-67890')
      label
        | 연락처
        input(type='tel', name='phone', value=values.phone || '', autocomplete='tel')
      label
        | 이메일
        input(type='email', name='email', value=values.email || '', autocomplete='email')
      label
        | 주소
        input(type='text', name='address', value=values.address || '', autocomplete='street-address')
      label
        | 메모
        textarea(name='memo', rows='4')= values.memo || ''
      button.primary-button(type='submit') 저장하고 카드 결제로 이동
