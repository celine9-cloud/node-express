extends ../layout

mixin money(value)
  | #{Number(value || 0).toLocaleString('ko-KR')}원

block content
  .page-shell.narrow
    h1 거래처 송금
    p.description 토스페이먼츠 지급대행 구조에 맞춰 셀러 등록과 지급 요청을 안전하게 준비합니다.

    if demoMode
      .notice
        strong 데모 모드
        p 실제 송금은 발생하지 않습니다. `TOSS_PAYOUT_SECRET_KEY`, `TOSS_PAYOUT_SECURITY_KEY`, `TOSS_PAYOUT_DEMO_MODE=false` 설정 후에만 외부 요청을 보냅니다.
    else
      .alert
        strong 실제 지급대행 모드
        p 지급대행은 회수가 어려울 수 있습니다. 금액과 계좌를 반드시 재확인하세요.

    if errors && errors.length
      ul.alert
        each error in errors
          li= error

    if result
      .summary-card.transfer-result
        span.label 송금 요청 결과
        strong #{result.transfer.status}
        p.muted #{result.transfer.recipientName} · #{result.transfer.accountNumberMasked}
        p
          b
            +money(result.transfer.amount)
          |  요청이 #{result.transfer.mode === 'demo' ? '데모로 기록' : '토스페이먼츠로 전송'}됐습니다.
        p.muted 지급대행 ID: #{result.transfer.refPayoutId}

    form.card-form(method='post', action='/transfers', autocomplete='off')
      label
        | 거래처명
        input(type='text', name='recipientName', value=values.recipientName, placeholder='예: 오직식자재', required)
      .form-grid
        label
          | 은행 코드
          input(type='text', name='bankCode', value=values.bankCode, placeholder='예: 088', inputmode='numeric', required)
        label
          | 예금주
          input(type='text', name='holderName', value=values.holderName, placeholder='예: 김오직', required)
      label
        | 계좌번호
        input(type='text', name='accountNumber', value=values.accountNumber, placeholder='숫자만 입력', inputmode='numeric', required)
      label
        | 송금 금액
        input(type='text', name='amount', value=values.amount, placeholder='예: 150000', inputmode='numeric', required)
      .form-grid
        label
          | 거래처 이메일
          input(type='email', name='recipientEmail', value=values.recipientEmail, placeholder='선택')
        label
          | 거래처 연락처
          input(type='tel', name='recipientPhone', value=values.recipientPhone, placeholder='선택')
      label
        | 통장 표시 문구
        input(type='text', name='transactionDescription', value=values.transactionDescription, maxlength='7', placeholder='최대 7자')
      label
        | 메모
        textarea(name='memo', rows='3', placeholder='내부 확인용 메모')= values.memo
      button.primary-button(type='submit') 안전하게 송금 요청하기

    h2 최근 송금 요청
    if transfers.length
      .list-card
        each transfer in transfers
          .list-row
            div
              strong= transfer.recipientName
              span #{transfer.status} · #{transfer.mode} · #{transfer.accountNumberMasked}
            b
              +money(transfer.amount)
    else
      .list-card
        .list-row
          div
            strong 아직 송금 요청이 없어요
            span 거래처 계좌와 금액을 입력해 첫 요청을 만들어보세요.
