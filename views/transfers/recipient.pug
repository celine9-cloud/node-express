extends ../layout

mixin money(value)
  | #{Number(value || 0).toLocaleString('ko-KR')}원

block content
  .transfer-flow
    .flow-top
      a.back-link(href='/checkout') ←
      .step-dots
        span.active
        span
        span
      form(method='post', action='/transfers/reset')
        button.link-button(type='submit') 처음부터

    .flow-title
      p.eyebrow 입금 1단계
      h1 어디로 입금할까요?
      p.description 거래처 계좌는 최종 요청 기록에 마스킹해서 저장합니다.

    if errors && errors.length
      ul.alert
        each error in errors
          li= error

    form.flow-card(method='post', action='/transfers/recipient', autocomplete='off')
      label
        span 거래처명
        input(type='text', name='recipientName', value=values.recipientName, placeholder='예: 오직식자재', required)
      .form-grid
        label
          span 은행 코드
          input(type='text', name='bankCode', value=values.bankCode, placeholder='088', inputmode='numeric', required)
        label
          span 예금주
          input(type='text', name='holderName', value=values.holderName, placeholder='김오직', required)
      label
        span 계좌번호
        input(type='text', name='accountNumber', value=values.accountNumber, placeholder='숫자만 입력', inputmode='numeric', required)
      button.primary-button(type='submit') 다음

    .section-header
      h2 최근 입금 요청
    if transfers.length
      .list-card
        each transfer in transfers
          .list-row
            div
              strong= transfer.recipientName
              span #{transfer.status} · #{transfer.accountNumberMasked}
            b
              +money(transfer.amount)
    else
      .list-card
        .list-row
          div
            strong 아직 입금 요청이 없어요
            span 자주 보내는 거래처가 여기에 표시돼요.
