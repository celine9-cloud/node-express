extends ../layout

block content
  .page-shell.narrow
    h1 약관 동의
    p.description 안전한 서비스 이용을 위해 필요한 동의만 먼저 확인할게요.

    if errors && errors.length
      ul.alert
        each error in errors
          li= error

    form.card-form(method='post', action='/auth/terms')
      input(type='hidden', name='provider', value=values.provider || 'email')
      input(type='hidden', name='next', value=values.next || '')
      .terms-box
        label.check-row
          input(type='checkbox', name='termsAccepted', checked=values.termsAccepted)
          span [필수] 서비스 이용약관에 동의합니다.
        p.term-copy 사업자 장부, 매출 조회, 결제 테스트 기능 이용에 필요한 기본 약관입니다.
        label.check-row
          input(type='checkbox', name='privacyAccepted', checked=values.privacyAccepted)
          span [필수] 개인정보 수집 및 이용에 동의합니다.
        p.term-copy 로그인, 고객정보, 연동 상태 저장을 위해 필요한 최소 정보를 처리합니다.
        label.check-row
          input(type='checkbox', name='marketingAccepted', checked=values.marketingAccepted)
          span [선택] 사업 소식과 혜택 알림을 받습니다.
      button.primary-button(type='submit')
        if values.provider === 'kakao'
          | 동의하고 카카오로 계속하기
        else
          | 동의하고 계속하기
