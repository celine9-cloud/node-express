# Copy this file to .env before running the scraper.
#
# Use only your own or explicitly authorized merchant account.
# Do not automate CAPTCHA, certificate login, OTP, or other security checks.

# Official merchant card sales service run by the Credit Finance Association.
CFIA_BASE_URL=https://www.cardsales.or.kr/main

# Optional: set a direct URL for the sales inquiry page after login.
# If empty, the script lets you move through the browser manually.
CFIA_TARGET_URL=

# The scraper reads the first matching table when no download button is configured.
CFIA_RESULT_TABLE_SELECTOR=table

# Selector that indicates the user is logged in. Adjust after checking the current UI.
CFIA_LOGIN_READY_SELECTOR=text=/로그아웃|마이페이지|회원정보/

# Optional selectors for filling a date range and clicking search.
# Leave empty if you prefer to set the period manually in the browser.
CFIA_DATE_FROM_SELECTOR=
CFIA_DATE_TO_SELECTOR=
CFIA_SEARCH_BUTTON_SELECTOR=
CFIA_DATE_FROM=
CFIA_DATE_TO=

# Optional selector for an Excel/CSV download button.
# If set, the script saves the downloaded file instead of parsing a table.
CFIA_DOWNLOAD_SELECTOR=

# Local-only paths. These are ignored by git.
CFIA_OUTPUT_DIR=data/card-sales
CFIA_STORAGE_STATE=.auth/cardsales-state.json
CFIA_OUTPUT_FORMAT=json

# Save parsed table rows into the local SQLite ledger database.
CFIA_SAVE_TO_DB=true
SALES_DB_PATH=data/ledger.sqlite

# Keep headless=false for first login because MFA/certificate flows need a real browser.
CFIA_HEADLESS=false
CFIA_KEEP_OPEN=false
CFIA_MANUAL_TIMEOUT_MS=180000
